#!/usr/bin/env bash
# Test stub for rsync: host:path arguments become local paths, -e/--rsh is
# dropped, then the real rsync runs. STUB_RSYNC_FAIL_MATCH, when set, makes
# any call whose arguments contain it fail (exit 23) without copying.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_lib.sh
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
out=()
skip=0
for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in
        -e|--rsh) skip=1; continue ;;
        --rsh=*) continue ;;
    esac
    if is_remote_arg "$a"; then
        a="$(map_remote_path "${a#*:}")"
    fi
    out+=("$a")
done
if [ -n "${STUB_RSYNC_FAIL_MATCH:-}" ] && [[ "$*" == *"$STUB_RSYNC_FAIL_MATCH"* ]]; then
    stub_log rsync FAILED "${out[*]}"
    echo "rsync stub: injected failure (STUB_RSYNC_FAIL_MATCH=$STUB_RSYNC_FAIL_MATCH)" >&2
    exit 23
fi
stub_log rsync "${out[*]}"
exec "$(real_bin rsync)" "${out[@]}"
