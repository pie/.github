#!/usr/bin/env bash
# Test stub for mv: records the call (so a test can see whether, and when, a
# live directory was renamed), then runs the real mv.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=_lib.sh
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
stub_log mv "$@"
exec "$(real_bin mv)" "$@"
